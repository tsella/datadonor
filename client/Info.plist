<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>la.tsel.datadonor.backgroundSync</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Data Donor</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.healthcare-fitness</string>
	<key>NSHealthShareUsageDescription</key>
	<string>DataDonor needs access to read your health data to securely sync it to your personal server.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>DataDonor needs access to write your health data to securely sync it to your personal server.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DataDonor needs your location to detect the current Wi-Fi network and verify you are connected to your target server.</string>
	<key>NSCameraUsageDescription</key>
	<string>DataDonor needs access to the camera to scan your API Key QR Code.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DataDonor needs access to your local network to discover your Fastify syncing server automatically.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_datadonor._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
